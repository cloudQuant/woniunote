{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "woniunote-backend",
    "version": "2.0.0",
    "description": "WoniuNote Backend - High-performance C++ API server using Drogon",
    "homepage": "https://github.com/yunjinqi/woniunote",
    "license": "MIT",
    "dependencies": [
        {
            "name": "drogon",
            "version>=": "1.9.0"
        },
        {
            "name": "openssl",
            "version>=": "3.0.0"
        },
        {
            "name": "jsoncpp",
            "version>=": "1.9.5"
        },
        {
            "name": "jwt-cpp",
            "version>=": "0.7.0"
        },
        {
            "name": "hiredis",
            "version>=": "1.1.0"
        },
        {
            "name": "libmysql",
            "version>=": "8.0.0"
        }
    ],
    "builtin-baseline": "2024.01.12",
    "overrides": [],
    "features": {
        "tests": {
            "description": "Build with test support",
            "dependencies": [
                "gtest"
            ]
        }
    }
}
