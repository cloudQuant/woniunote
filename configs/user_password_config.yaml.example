# WoniuNote 用户密码配置示例文件
# 复制此文件为 user_password_config.yaml 并填入实际配置

# 数据库配置
database:
  host: localhost
  port: 3306
  name: woniunote
  username: woniunote_user
  password: your_secure_password_here

# Redis配置
redis:
  host: localhost
  port: 6379
  db: 0
  password: your_redis_password_here  # 如果Redis设置了密码

# 邮件配置
mail:
  smtp_server: smtp.example.com
  smtp_port: 587
  use_tls: true
  username: your_email@example.com
  password: your_email_password_here

# 安全密钥
security:
  secret_key: your_very_secure_secret_key_here_change_this_in_production
  
# 注意：
# 1. 请勿将此文件提交到版本控制系统
# 2. 确保文件权限为 600 (仅所有者可读写)
# 3. 生产环境建议使用环境变量而非配置文件