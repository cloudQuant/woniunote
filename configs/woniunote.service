[Unit]
Description=WoniuNote C++ Backend Service
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/woniunote/backend_cpp/build
ExecStart=/root/woniunote/backend_cpp/build/woniunote_backend
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=append:/root/woniunote/logs/backend.log
StandardError=append:/root/woniunote/logs/backend_error.log

# 环境变量
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
# 清除 anaconda 的库路径，使用系统库避免 GLIBCXX 版本冲突
Environment=LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu:/usr/local/lib

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/root/woniunote/backend_cpp/build/logs
ReadWritePaths=/root/woniunote/backend_cpp/build/uploads
ReadWritePaths=/root/woniunote/logs
ReadWritePaths=/root/woniunote/uploads

[Install]
WantedBy=multi-user.target
