[Unit]
Description=WoniuNote C++ Backend Service
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/woniunote/backend_cpp/build
ExecStart=/var/www/woniunote/backend_cpp/build/woniunote_backend
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=append:/var/www/woniunote/logs/backend.log
StandardError=append:/var/www/woniunote/logs/backend_error.log

# 环境变量
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 安全设置
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/woniunote/backend_cpp/build/logs
ReadWritePaths=/var/www/woniunote/backend_cpp/build/uploads
ReadWritePaths=/var/www/woniunote/logs

[Install]
WantedBy=multi-user.target
