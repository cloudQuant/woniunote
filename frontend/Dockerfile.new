# ⚠️ 已废弃 / NOT A SUPPORTED RELEASE ENTRY (迭代20 / Epic 20.3A)
#
# 此文件没有被任何脚本、文档或 CI 引用，也不是发布入口：
#   - 使用 `npm install`（会重新解析依赖图），而不是锁文件精确的 `npm ci`；
#   - 基础镜像 Node 20 未与 frontend/package.json 的 engines (>=20.19.0) 对齐核验。
# 当前支持的前端发布路径是仓库根目录的 start_app.sh prod / scripts/setup_ubuntu.sh
# （Nginx 直接服务 frontend/dist）。如需恢复容器化发布，请先按上述路径重建并纳入
# CI 核验，否则不要使用本文件。

# 构建阶段
FROM node:20-alpine as build

WORKDIR /app

# 复制依赖文件
COPY package*.json ./

# 安装依赖
RUN npm install

# 复制源代码
COPY . .

# 构建
RUN npm run build

# 生产阶段
FROM nginx:alpine

# 复制构建产物
COPY --from=build /app/dist /usr/share/nginx/html

# 复制 nginx 配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
