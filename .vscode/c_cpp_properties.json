{
  "configurations": [
    {
      "name": "macos-clang-arm64",
      "includePath": [
        "${workspaceFolder}/**",
        "${workspaceFolder}/backend_cpp",
        "${workspaceFolder}/backend_cpp/build/vcpkg_installed/arm64-osx/include",
        "${workspaceFolder}/backend_cpp/third_party",
        "${env:HOME}/vcpkg/installed/arm64-osx/include"
      ],
      "defines": [
        "__APPLE__"
      ],
      "compilerPath": "/usr/bin/clang",
      "cStandard": "c17",
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-arm64",
      "configurationProvider": "ms-vscode.cmake-tools"
    }
  ],
  "version": 4
}