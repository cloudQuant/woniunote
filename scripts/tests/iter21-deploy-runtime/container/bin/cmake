#!/usr/bin/env bash
set -Eeuo pipefail
trap 'status=$?; printf "FIXTURE_SHIM cmake error status=%s line=%s command=%s\n" "$status" "$LINENO" "$BASH_COMMAND" >&2; exit "$status"' ERR
printf 'FIXTURE_SHIM cmake %s cwd=%s\n' "$*" "$PWD" >&2
if [ "${1:-}" = --build ]; then
    build_dir="${2:?cmake build directory required}"
    source_dir="$(dirname "$build_dir")"
    version="$(cat "$source_dir/fixture-version.txt")"
    mkdir -p "$build_dir"
    cat > "$build_dir/woniunote_backend" <<EOF
#!/usr/bin/env bash
exec /usr/bin/python3 - '$version' "\$@" <<'PY'
import json
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

version = sys.argv[1]
config_path = Path(sys.argv[2])
config = json.loads(config_path.read_text(encoding='utf-8'))
upload = Path(config['fixture_data_dir']) / 'uploads' / 'smoke.bin'
png = __import__('base64').b64decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+k6CkAAAAASUVORK5CYII=')

class Handler(BaseHTTPRequestHandler):
    def respond(self, status, body, content_type):
        self.send_response(status)
        self.send_header('Content-Type', content_type)
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split('?', 1)[0]
        if path == '/health':
            return self.respond(200, b'ok\\n', 'text/plain')
        if path == '/api/articles/types':
            return self.respond(200, json.dumps({'code': 200, 'version': version}).encode(), 'application/json')
        if path.startswith('/api/thumb/'):
            return self.respond(200, png, 'image/png')
        if path in ('/api/uploads/smoke.bin', '/uploads/smoke.bin'):
            return self.respond(200, upload.read_bytes(), 'application/octet-stream')
        if path == '/api/fail500':
            return self.respond(500, b'fixture upstream error\\n', 'text/plain')
        if path.startswith('/api/'):
            return self.respond(404, b'fixture API not found\\n', 'application/json')
        return self.respond(404, b'fixture backend route not found\\n', 'text/plain')

    def log_message(self, fmt, *args):
        print('fixture-backend ' + (fmt % args), flush=True)

ThreadingHTTPServer(('127.0.0.1', 5173), Handler).serve_forever()
PY
EOF
    chmod 0755 "$build_dir/woniunote_backend"
    test -x "$build_dir/woniunote_backend"
    printf 'FIXTURE_SHIM cmake artifact=%s version=%s\n' "$build_dir/woniunote_backend" "$version" >&2
    printf 'fixture cmake build dir=%s version=%s\n' "$build_dir" "$version" > "$build_dir/CMakeCache.txt"
else
    build_dir=''
    previous=''
    for arg in "$@"; do
        if [ "$previous" = -B ]; then build_dir="$arg"; break; fi
        previous="$arg"
    done
    [ -n "$build_dir" ] || { printf 'cmake fixture configure missing -B\n' >&2; exit 64; }
    mkdir -p "$build_dir"
    printf 'fixture cmake configure\n' > "$build_dir/CMakeCache.txt"
fi
