import os
import sys
import tempfile
import pytest
from unittest.mock import patch, MagicMock
import sqlite3

# Add the project root to Python path for imports
project_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if project_root not in sys.path:
    sys.path.insert(0, project_root)

# Set testing environment
os.environ['TESTING'] = 'True'
os.environ['FLASK_ENV'] = 'testing'

# Mock configuration for testing
TEST_CONFIG = {
    'database': {
        'SQLALCHEMY_DATABASE_URI': 'sqlite:///test.db'
    },
    'admin': {
        'username': 'test_admin',
        'nickname': 'Test Admin',
        'password': 'test_password123!'
    },
    'editor': {
        'username': 'test_editor',
        'nickname': 'Test Editor',
        'password': 'test_password123!'
    },
    'user': {
        'username': 'test_user',
        'nickname': 'Test User',
        'password': 'test_password123!'
    }
}

ARTICLE_CONFIG = {
    'ARTICLE_TYPES': {
        'tech': '技术',
        'life': '生活',
        'travel': '旅行',
        'food': '美食',
        'study': '学习'
    }
}


@pytest.fixture(scope='session', autouse=True)
def mock_config():
    """Mock configuration loading to avoid database configuration issues."""
    try:
        with patch('woniunote.common.utils.read_config') as mock_read_config:
            def side_effect(config_file=None):
                if config_file and 'article_type_config' in config_file:
                    return ARTICLE_CONFIG
                return TEST_CONFIG
            
            mock_read_config.side_effect = side_effect
            yield mock_read_config
    except ImportError:
        # If woniunote.common.utils doesn't exist, just yield None
        yield None


@pytest.fixture(scope='session')
def temp_db():
    """Create a temporary SQLite database for testing."""
    with tempfile.NamedTemporaryFile(suffix='.db', delete=False) as f:
        db_path = f.name
    
    # Create basic tables
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    
    # Create basic tables for testing
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY,
            username TEXT UNIQUE NOT NULL,
            password TEXT NOT NULL,
            nickname TEXT,
            email TEXT
        )
    ''')
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS articles (
            id INTEGER PRIMARY KEY,
            title TEXT NOT NULL,
            content TEXT,
            author_id INTEGER,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (author_id) REFERENCES users (id)
        )
    ''')
    
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS comments (
            id INTEGER PRIMARY KEY,
            content TEXT NOT NULL,
            article_id INTEGER,
            author_id INTEGER,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (article_id) REFERENCES articles (id),
            FOREIGN KEY (author_id) REFERENCES users (id)
        )
    ''')
    
    conn.commit()
    conn.close()
    
    yield db_path
    
    # Cleanup
    try:
        os.unlink(db_path)
    except FileNotFoundError:
        pass


@pytest.fixture
def mock_flask_app():
    """Mock Flask app for testing."""
    try:
        with patch('woniunote.app.create_app') as mock_create_app:
            app = MagicMock()
            app.config = {
                'TESTING': True,
                'SQLALCHEMY_DATABASE_URI': 'sqlite:///test.db',
                'SQLALCHEMY_TRACK_MODIFICATIONS': False,
                'SECRET_KEY': 'test_secret_key'
            }
            app.app_context.return_value.__enter__ = MagicMock()
            app.app_context.return_value.__exit__ = MagicMock()
            mock_create_app.return_value = app
            yield app
    except ImportError:
        # If woniunote.app doesn't exist, create a basic mock
        app = MagicMock()
        app.config = {
            'TESTING': True,
            'SQLALCHEMY_DATABASE_URI': 'sqlite:///test.db',
            'SQLALCHEMY_TRACK_MODIFICATIONS': False,
            'SECRET_KEY': 'test_secret_key'
        }
        yield app


@pytest.fixture
def mock_db():
    """Mock database for testing."""
    try:
        with patch('woniunote.common.database.db') as mock_db:
            mock_db.session = MagicMock()
            mock_db.Model = MagicMock()
            mock_db.create_all = MagicMock()
            yield mock_db
    except ImportError:
        # If woniunote.common.database doesn't exist, create a basic mock
        mock_db = MagicMock()
        mock_db.session = MagicMock()
        mock_db.Model = MagicMock()
        mock_db.create_all = MagicMock()
        yield mock_db


@pytest.fixture
def client(mock_flask_app, mock_db):
    """Test client for Flask app."""
    with mock_flask_app.test_client() as client:
        yield client


def pytest_configure(config):
    """Configure pytest."""
    # Set environment variable for testing
    os.environ['TESTING'] = 'true'
    
    # Add custom markers
    config.addinivalue_line(
        "markers", "unit: mark test as unit test"
    )
    config.addinivalue_line(
        "markers", "integration: mark test as integration test"
    )
    config.addinivalue_line(
        "markers", "functional: mark test as functional test"
    )


def pytest_collection_modifyitems(config, items):
    """Modify test collection to handle import errors gracefully."""
    # Skip tests that can't be imported due to dependency issues
    skip_import_error = pytest.mark.skip(reason="Import error - dependencies not available")
    
    for item in items:
        # You can add more sophisticated logic here to determine which tests to skip
        pass 